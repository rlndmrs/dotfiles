#!/bin/bash

sudo apt install curl vim-gtk3 git mc fzf ripgrep fd-find wl-clipboard \
	rclone tree tmux alacritty gnome-shell-extension-manager

ln -s $(pwd)/env ~/.env
#echo '. ~/.env' >> ~/.bashrc

mkdir -p ~/.config
ln -s $(pwd)/config/user-dirs.dirs ~/.config/
xdg-user-dirs-update

git clone https://github.com/tpope/vim-vinegar.git \
	~/.vim/pack/tpope/start/vim-vinegar
git clone https://github.com/zenbones-theme/zenbones.nvim.git \
	~/.vim/pack/themes/start/zenbones.nvim
mkdir -p ~/.vim
ln -s $(pwd)/vimrc ~/.vimrc

ln -s $(pwd)/emacs ~/.emacs

mkdir -p ~/.config/tmux
ln -s $(pwd)/config/tmux/tmux.conf ~/.config/tmux/

mkdir -p ~/.config/mc
cp $(pwd)/config/mc/ini ~/.config/mc/
ln -s $(pwd)/config/mc/panels.ini ~/.config/mc/

mkdir -p ~/.config/alacritty
ln -s $(pwd)/config/alacritty/alacritty.toml ~/.config/alacritty/

ln -s $(pwd)/config/xkb ~/.config

FONT_DIR="$HOME/.local/share/fonts"

if ! ls "$FONT_DIR" 2>/dev/null | grep -qi "JetBrainsMonoNerdFont-Regular"; then
    cd ~/Downloads || exit 1
    wget -q https://github.com/ryanoasis/nerd-fonts/releases/download/v3.5.1/JetBrainsMono.zip
    unzip -o JetBrainsMono.zip -d "$FONT_DIR/"
    fc-cache -f "$FONT_DIR"
fi

mkdir -p ~/.config/systemd/user
ln -s $(pwd)/config/systemd/user/ssh-agent.service ~/.config/systemd/user/
systemctl --user daemon-reload
systemctl --user enable --now ssh-agent.service
ln -s $(pwd)/ssh/config ~/.ssh
